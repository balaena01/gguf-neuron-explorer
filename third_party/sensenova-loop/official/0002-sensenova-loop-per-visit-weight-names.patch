+void llama_model_sensenova_loop::load_tensors_post() {
+    // LLAMA_SENSENOVA_SHARED_NAMES=1 keeps one name per stored tensor, so a LoRA on a stored block acts on every visit
+    const char * shared = getenv("LLAMA_SENSENOVA_SHARED_NAMES");
+    if ((shared && atoi(shared) != 0) || layer_tensor_sources.empty()) {
+        return;
+    }
+    ggml_tensor * llama_layer::* fields[] = {
+        &llama_layer::wq, &llama_layer::wk, &llama_layer::wv, &llama_layer::wo, &llama_layer::wqkv,
+        &llama_layer::wqkv_gate, &llama_layer::wqkv_z, &llama_layer::ssm_out, &llama_layer::ssm_beta,
+        &llama_layer::ssm_alpha, &llama_layer::ssm_beta_alpha, &llama_layer::ssm_beta_alpha_cat,
+        &llama_layer::ffn_gate, &llama_layer::ffn_down, &llama_layer::ffn_up,
+        &llama_layer::hc_attn_fn, &llama_layer::hc_ffn_fn,
+    };
+    const size_t n_fields = sizeof(fields) / sizeof(fields[0]);
+    const int n_layer = (int) hparams.n_layer();
+    ggml_init_params ip = { (size_t) n_layer * n_fields * ggml_tensor_overhead(), nullptr, true };
+    loop_view_ctx.reset(ggml_init(ip));
+    int n_views = 0;
+    for (int il = 0; il < n_layer; ++il) {
+        if (layer_tensor_sources[il] == (uint32_t) il) {
+            continue;
+        }
+        auto & layer = layers[il];
+        for (auto f : fields) {
+            ggml_tensor * src = layer.*f;
+            if (src == nullptr || src->buffer == nullptr || src->data == nullptr) {
+                continue;
+            }
+            const char * dot1 = strchr(src->name, '.');              // "blk.<n>.<rest>" -> "blk.<il>.<rest>"
+            const char * dot2 = dot1 ? strchr(dot1 + 1, '.') : nullptr;
+            if (dot2 == nullptr) {
+                continue;
+            }
+            ggml_tensor * v = ggml_view_tensor(loop_view_ctx.get(), src);
+            ggml_format_name(v, "blk.%d.%s", il, dot2 + 1);
+            if (ggml_backend_view_init(v) != GGML_STATUS_SUCCESS) {
+                throw std::runtime_error(format("sensenova_loop: cannot make the view %s", v->name));
+            }
+            layer.*f = v;
+            tensors_by_name.emplace_back(ggml_get_name(v), v);
+            ++n_views;
+        }
+    }
+    LLAMA_LOG_INFO("%s: sensenova_loop: %d per-visit weight names for the shared layers\n", __func__, n_views);
+}
+
