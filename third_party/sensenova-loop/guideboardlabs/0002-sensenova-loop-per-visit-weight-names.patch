+void llama_model_sensenova_loop::load_tensors_post() {
+    // LLAMA_SENSENOVA_SHARED_NAMES=1 keeps the published behaviour: one name per stored tensor, so a LoRA on a
+    // stored block always acts on both visits
+    const char * shared = getenv("LLAMA_SENSENOVA_SHARED_NAMES");
+    if (shared && atoi(shared) != 0) {
+        return;
+    }
+    if (hparams.mhc_loop_shift == 0) {
+        return;
+    }
+    const int lo = (int) hparams.mhc_loop_start2;
+    const int hi = lo + (int) hparams.mhc_loop_shift;
+    ggml_tensor * llama_layer::* fields[] = {
+        &llama_layer::wq, &llama_layer::wk, &llama_layer::wv, &llama_layer::wo, &llama_layer::wqkv,
+        &llama_layer::wqkv_gate, &llama_layer::ssm_out, &llama_layer::ssm_beta, &llama_layer::ssm_alpha,
+        &llama_layer::ffn_gate, &llama_layer::ffn_down, &llama_layer::ffn_up,
+    };
+    const size_t n_fields = sizeof(fields) / sizeof(fields[0]);
+    ggml_init_params ip = { (size_t) (hi - lo) * n_fields * ggml_tensor_overhead(), nullptr, true };
+    loop_view_ctx.reset(ggml_init(ip));
+    int n_views = 0;
+    for (int il = lo; il < hi; ++il) {
+        auto & layer = layers[il];
+        for (auto f : fields) {
+            ggml_tensor * src = layer.*f;
+            if (src == nullptr || src->buffer == nullptr || src->data == nullptr) {
+                continue;
+            }
+            // "blk.<n>.<rest>" -> "blk.<il>.<rest>"
+            const char * dot1 = strchr(src->name, '.');
+            const char * dot2 = dot1 ? strchr(dot1 + 1, '.') : nullptr;
+            if (dot2 == nullptr) {
+                continue;
+            }
+            ggml_tensor * v = ggml_view_tensor(loop_view_ctx.get(), src);
+            ggml_format_name(v, "blk.%d.%s", il, dot2 + 1);
+            if (ggml_backend_view_init(v) != GGML_STATUS_SUCCESS) {
+                throw std::runtime_error(format("sensenova_loop: cannot make the view %s", v->name));
+            }
+            layer.*f = v;
+            tensors_by_name.emplace_back(ggml_get_name(v), v);
+            ++n_views;
+        }
+    }
+    LLAMA_LOG_INFO("%s: sensenova_loop: %d second-visit weight names (views of blocks %d..%d)\n", __func__, n_views,
+            lo - (int) hparams.mhc_loop_shift, hi - 1 - (int) hparams.mhc_loop_shift);
+}
